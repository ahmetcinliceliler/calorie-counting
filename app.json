{
  "expo": {
    "name": "Kalori Lens",
    "slug": "diyetuygulamam",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kalorilens",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ahmet.diyetapp",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ahmet.diyetapp",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Barkod okutmak ve yemek fotoğrafı çekmek için kameranı kullanırız.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerindeki bir yemek fotoğrafını analiz etmek için fotoğraflarına erişiriz.",
          "cameraPermission": "Yemek fotoğrafı çekmek için kameranı kullanırız.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Sana daha alakalı reklamlar gösterebilmek için izin istiyoruz. Premium üyelikte reklam yoktur."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4f25b9fd-547a-433c-b1cd-05f65a21a846"
      }
    }
  }
}
