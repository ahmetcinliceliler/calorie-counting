# Edge Function secret'ları. Bu dosyayı .env olarak kopyalayıp doldurun (git'e girmez), sonra:
#   npx supabase secrets set --env-file supabase/functions/.env

# OpenAI uyumlu sağlayıcı. NVIDIA API catalog örneği:
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=nvapi-...
# build.nvidia.com'da görsel (vision) destekli bir modelin kimliği
AI_VISION_MODEL=
# Metin modeli (boşsa AI_VISION_MODEL kullanılır)
AI_TEXT_MODEL=
# Sağlayıcı response_format: json_object destekliyorsa true
AI_JSON_MODE=false
AI_TIMEOUT_MS=45000
