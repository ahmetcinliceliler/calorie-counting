# Uygulama (herkese açık değerler; EXPO_PUBLIC_ önekliler uygulama paketine girer)
EXPO_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# RevenueCat (abonelik) — boşsa satın alma kapalı
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob banner reklam birimleri — geliştirmede Google test reklamı kullanılır.
# Yayından önce app.json'daki test App ID'leri de AdMob hesabındakilerle değiştirilmeli.
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=

# Yasal sayfalar (profil ekranında bağlantı olarak görünür)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# AI anahtarı BURAYA YAZILMAZ. Supabase secret olarak ayarlanır:
#   npx supabase secrets set --env-file supabase/functions/.env
# Örnek için: supabase/functions/.env.example
